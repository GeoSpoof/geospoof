audit-level=moderate

# Don't run dependencies' install/postinstall scripts. That is how npm malware usually executes,
# and `npm ci` here runs in CI jobs next to release credentials. Nothing in this tree needs its
# script: esbuild ships its binary as a platform package. Explicit `npm run`/`npm test` still work.
# Side effect: our own `prepare` (husky) is skipped too, so on a fresh clone run `npx husky` once.
ignore-scripts=true
