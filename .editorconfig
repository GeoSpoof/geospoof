# EditorConfig — https://editorconfig.org
# Baseline whitespace/charset rules applied by the editor before Prettier runs,
# and in files Prettier does not format. Values match .prettierrc so the two
# never disagree.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown: trailing whitespace can be a meaningful line break, so leave it.
[*.md]
trim_trailing_whitespace = false
